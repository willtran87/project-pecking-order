			leaf.rotation_degrees.z = -20.0 + leaf_index * 20.0
	else:
		_add_box(workstation, "FeedSnackPacket", Vector3(0.38, 0.12, 0.28), Vector3(0.98, 1.04, -0.18), Color("c1a052"))


